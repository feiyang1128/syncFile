# https://clashparty.org/docs/guide/override/yaml

# | 规则                  | 示例                                     | 匹配说明                                                                 |
# | --------------------- | ---------------------------------------- | -------------------------------------------------------------------------|
# | `DOMAIN`              | `DOMAIN,google.com,DIRECT`               | 精确匹配 `google.com`，不匹配 `www.google.com`。                         |
# | `DOMAIN-KEYWORD`      | `DOMAIN-KEYWORD,google,DIRECT`           | 匹配包含 `google` 的所有域名，如 `google.com`、`google123.com`。         |
# | `DOMAIN-SUFFIX`       | `DOMAIN-SUFFIX,google.com,DIRECT`        | 匹配以 `google.com` 结尾的域名，如 `mail.google.com`、`www.google.com`。 |
# | `IP-CIDR`             | `IP-CIDR,192.168.1.0/24,DIRECT`          | 匹配 `192.168.1.0` 到 `192.168.1.255` 范围的所有 IP 地址。               |
# | `GEOIP`               | `GEOIP,CN,DIRECT`                        | 匹配中国地区（CN）的所有 IP 地址。                                       |
# | `DOMAIN-KEYWORD-FULL` | `DOMAIN-KEYWORD-FULL,google,DIRECT`      | 精确匹配 `google` 的域名，如 `google.com`，不匹配 `google123.com`。      |

proxy-groups+:
  - name: ✨ AI
    type: url-test
    include-all: true
    exclude-type: direct
    url: https://www.gstatic.com/generate_204
    interval: 300
    lazy: true
    #filter: "日本|JP|Japan|新加坡|SG|Singapore|美国|US|USA"  保留的节点
    exclude-filter: "(?i)v6|香港|HK|🇭🇰|台湾|TW|🇹🇼|澳门|MO|🇲🇴|🇨🇳" #删除的节点
rule-providers:
    aiRule:  
         type: http
         behavior: classical
         url: "https://gh-proxy.org/https://raw.githubusercontent.com/feiyang1128/syncFile/refs/heads/main/Mihomo/AI.txt"
         path: ./rule/aiRule.yaml
         interval: 3600
+rules:
  - RULE-SET,aiRule,✨ AI
